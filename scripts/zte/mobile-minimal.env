#!/bin/sh
#===============================================================================
# Mobile minimal build plugin list (include-list).
#
# Set OPENCLAW_BUNDLED_PLUGINS to control which extensions are:
#  - built into the bundled output
#  - included in pnpm workspace for dependency installation
#
# Usage:
#   source scripts/zte/mobile-minimal.env
#   node scripts/zte/generate-minimal-workspace.mjs
#   pnpm install
#   pnpm run build
#
# Edit scripts/zte/mobile-minimal-plugins.txt to add/remove plugins.
#===============================================================================

OPENCLAW_BUNDLED_PLUGINS="$(
  grep -v '^#' scripts/zte/mobile-minimal-plugins.txt \
    | grep -v '^[[:space:]]*$' \
    | tr '\n' ',' \
    | sed 's/,$//'
)"
export OPENCLAW_BUNDLED_PLUGINS
