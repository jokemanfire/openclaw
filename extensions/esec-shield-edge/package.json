        {
          "source": "bin/esec-shield-daemon-edge-v2026.5.18-linux-arm64",
          "output": "bin/esec-shield-daemon-edge-v2026.5.18-linux-arm64"
        },
        {
          "source": "bin/esec-shield-daemon-edge-v2026.5.18-linux-x64",
          "output": "bin/esec-shield-daemon-edge-v2026.5.18-linux-x64"
        }
