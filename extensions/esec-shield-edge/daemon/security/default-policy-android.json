{
  "commandWhiteDetection":{
    "meta":"Android",
    "description":"命令白名单规则,decision配置包含BLOCK,CONFIRM,ALLOW",
    "policyRules": [
      { "id": "tools_cli_block_reboot_phone", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\breboot_phone\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh breboot_phone为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_download_or_install_app", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\bdownload_or_install_app\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh download_or_install_app为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_uninstall_app", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\buninstall_app\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh uninstall_app为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_shutdown_phone", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\bshutdown_phone\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh shutdown_phone为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 }
    ]
  },
  "pathDetection":{
    "meta":"Android",
    "description":"路径检测规则,decision配置包含BLOCK,CONFIRM,ALLOW",
    "policyRules": [
    ]
