    "denyPaths": [
      "/proc",
      "/proc/self/environ",
      "/etc/passwd",
      "/etc/shadow",
      "/etc/gshadow",
      "/etc/sudoers",
      "~/.openclaw/credentials"
    ],
    "dangerousFiles": [
      "openclaw.json",
      "secrets.json",
      "auth-profiles.json",
      "auth.json",
      ".gitconfig",
      ".gitmodules",
      ".bashrc",
      ".bash_profile",
      ".zshrc",
      ".zprofile",
      ".profile",
      ".ripgreprc",
      ".mcp.json"
    ],
    "dangerousDirectories": [
      ".git",
      ".vscode",
      ".idea",
      ".openclaw"
    ]
  },
  "tools": {
    "gateway": {
      "allowActions": ["config.get", "config.schema"],
      "mutateActions": ["config.apply", "config.patch"],
      "askActions": ["restart", "update.run"],
      "denyActions": [],
      "sensitiveConfigKeys": [
        "gateway.auth.mode",
        "gateway.auth.token",
        "gateway.auth.password",
        "hooks.enabled",
        "hooks.token",
        "hooks.allowrequestsessionkey",
        "hooks.allowedagentids",
        "hooks.allowedsessionkeyprefixes",
        "allowunsafeexternalcontent",
        "agents.defaults.sandbox.mode",
        "tools.profile",
        "tools.allow",
        "tools.deny",
        "tools.exec.security",
        "tools.exec.ask",
        "tools.exec.safebins",
        "plugins.enabled",
        "plugins.allow",
        "plugins.entries"
      ]
    },
    "cron": {
      "allowActions": ["status", "list", "runs"],
      "mutateActions": ["add", "update"],
      "askActions": ["remove", "run", "wake"],
      "denyActions": [],
      "autonomousPayloadKinds": ["agentturn"],
      "autonomousSessionTargets": ["isolated"],
      "externalWebhookModes": ["webhook"],
      "internalUrlMarkers": ["localhost", "127.0.0.1", "::1", ".local", ".internal"]
    },
    "sessionsSpawn": {
      "askRuntimes": ["acp"],
      "askModes": ["session"],
      "askWhenThreadRequested": true,
      "askWhenCrossAgent": true,
      "askWhenTargetWithoutCurrent": true
    },
    "sessionsSend": {
      "allowSameSession": true,
      "allowSameAgentWithoutSession": true,
      "defaultAction": "ask"
    },
    "subagents": {
      "allowActions": ["", "list"],
      "askActions": ["kill", "steer"],
      "denyActions": [],
      "defaultAction": "ask"
    },
    "nodes": {
      "allowActions": [
        "status",
        "describe",
        "pending",
        "camera_list",
        "notifications_list",
        "device_status",
        "device_info",
        "device_permissions",
        "device_health"
      ],
      "askActions": [
        "approve",
        "reject",
        "notify",
        "camera_snap",
        "camera_clip",
        "photos_latest",
        "screen_record",
        "location_get",
        "notifications_action"
      ],
      "denyActions": [],
      "defaultAction": "ask"
    },
    "exec": {
      "shell": {
        "useBuiltinCommandRules": true,
        "internalHosts": [],
        "internalHostSuffixes": [],
        "commandRules": [
          {
            "id": "builtin.system.chmod.any_args",
            "matchType": "any_args",
            "baseCommand": "chmod",
            "action": "ask",
            "severity": "high",
            "reason": "chmod 会修改文件权限，可能影响系统安全"
          },
          {
            "id": "builtin.system.chown",
            "matchType": "any_args",
            "baseCommand": "chown",
            "action": "ask",
            "severity": "high",
            "reason": "chown 会修改文件权限，可能影响系统安全"
          },
          {
            "id": "builtin.find.delete",
            "matchType": "dangerous_flags",
            "baseCommand": "find",
            "forbiddenFlags": ["-delete"],
            "action": "ask",
            "severity": "critical",
            "reason": "find -delete 会删除匹配的文件，可能导致数据丢失"
          },
          {
            "id": "builtin.kernel.insmod",
            "matchType": "any_args",
            "baseCommand": "insmod",
            "action": "deny",
            "severity": "critical",
            "reason": "insmod 会加载内核模块，可能影响系统稳定性"
          },
          {
            "id": "builtin.xargs.rm",
            "matchType": "any_args",
            "baseCommand": "xargs",
            "requiredSubCommands": ["rm"],
            "action": "ask",
            "severity": "critical",
            "reason": "any_arg rm涉及批量删除，需要人工审批"
          },
          {
            "id": "builtin.openclaw.cli",
            "matchType": "any_args",
            "baseCommand": "openclaw",
            "action": "ask",
            "severity": "high",
