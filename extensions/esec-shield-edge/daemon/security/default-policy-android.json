{
  "commandWhiteDetection":{
    "meta":"Android",
    "description":"命令白名单规则，decision 配置包含 BLOCK,CONFIRM,ALLOW",
    "policyRules": [
      { "id": "tools_cli_block_reboot_phone", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\breboot_phone\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh breboot_phone 为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_download_or_install_app", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\bdownload_or_install_app\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh download_or_install_app 为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_uninstall_app", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\buninstall_app\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh uninstall_app 为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 },
      { "id": "tools_cli_block_shutdown_phone", "decision": "BLOCK", "pattern": "^(?:(?:/(?:bin|system\\/bin)/(?:sh|bash)|sh|bash)\\s+-c\\s+)?['\"]?\\/system_ext\\/bin\\/tools-cli\\.sh\\s+.*\\bshutdown_phone\\b.*['\"]?\\s*$", "flags": "i", "reason": "tools-cli.sh shutdown_phone 为高危操作，需要用户手动执行", "risk": "CRITICAL", "policyLevel": 1 }
    ]
  },
  "pathDetection":{
    "meta":"Android",
    "description":"路径检测规则，decision 配置包含 BLOCK,CONFIRM,ALLOW",
    "policyRules": [
    ]
  },
  "path": {
    "allowReadDirs": [],
    "allowWriteDirs": [],
    "sensitiveReadPaths": [],
    "sensitiveReadFiles": [],
    "sensitiveWritePaths": [],
    "denyPaths": [],
    "dangerousFiles": [],
    "dangerousDirectories": []
  },
  "tools": {
    "gateway": {
      "allowActions": [],
      "mutateActions": [],
      "askActions": [],
      "denyActions": [],
      "sensitiveConfigKeys": []
    },
    "cron": {
      "allowActions": [],
      "mutateActions": [],
      "askActions": [],
      "denyActions": [],
      "autonomousPayloadKinds": [],
      "autonomousSessionTargets": [],
      "externalWebhookModes": [],
      "internalUrlMarkers": []
    },
    "sessionsSpawn": {
      "askRuntimes": [],
      "askModes": [],
      "askWhenThreadRequested": false,
      "askWhenCrossAgent": false,
      "askWhenTargetWithoutCurrent": false
    },
    "sessionsSend": {
      "allowSameSession": false,
      "allowSameAgentWithoutSession": false,
      "defaultAction": "ask"
    },
    "subagents": {
      "allowActions": [],
      "askActions": [],
      "denyActions": [],
      "defaultAction": "ask"
    },
    "nodes": {
      "allowActions": [],
      "askActions": [],
      "denyActions": [],
      "defaultAction": "ask"
    },
    "exec": {
      "shell": {
        "useBuiltinCommandRules": true,
        "internalHosts": [],
        "internalHostSuffixes": [],
        "commandRules": [
          {
            "id": "builtin.rm.any",
            "matchType": "any_args",
            "baseCommand": "rm",
            "action": "deny",
            "severity": "critical",
            "reason": "rm 会永久删除文件，rm 操作为高危操作，需用户手动执行"
          },
          {
            "id": "builtin.rm.recursive",
            "matchType": "dangerous_flags",
            "baseCommand": "rm",
            "forbiddenFlags": ["-r", "-R", "--recursive"],
            "action": "deny",
            "severity": "critical",
            "reason": "递归 rm 可能永久删除大规模目录树，rm 操作为高危操作，需用户手动执行"
          },
          {
            "id": "builtin.rm.force",
            "matchType": "dangerous_flags",
            "baseCommand": "rm",
            "forbiddenFlags": ["-f", "-F", "--force"],
            "action": "deny",
            "severity": "critical",
            "reason": "强制 rm 会跳过安全提示并忽略缺失目标，rm 操作为高危操作，需用户手动执行"
          }
        ]
      }
    }
  }
}
