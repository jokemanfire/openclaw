      "auth.json"
    ],
    "sensitiveWritePaths": [
      "/boot",
      "/bin",
      "/sbin",
      "/lib",
      "/lib64",
      "/usr/bin",
      "/usr/sbin",
      "/usr/lib",
      "/usr/lib64",
      "/usr/local/bin",
      "/usr/local/sbin",
      "/usr/local/lib",
      "/etc/hosts",
      "/etc/resolv.conf",
      "/etc/passwd",
      "/etc/group",
      "/etc/shadow",
      "/etc/gshadow",
      "/etc/sudoers",
      "/etc/sudoers.d",
      "/etc/systemd",
      "/lib/systemd",
      "/usr/lib/systemd",
      "/etc/init.d",
      "/etc/rc.d",
      "/etc/rc.local",
      "/etc/profile.d",
      "/etc/ssh",
      "/etc/ssl/private",
      "/etc/pki/tls/private",
      "/etc/pki/private",
      "/etc/letsencrypt",
      "/var/spool/cron",
      "/etc/cron.d",
      "/etc/cron.daily",
      "/etc/cron.hourly",
      "/etc/cron.monthly",
      "/etc/cron.weekly",
      "~/.ssh",
      "/root/.ssh",
      "~/.config/systemd/user",
      "~/.local/share/systemd/user",
      "~/.config/autostart",
      "~/.openclaw/openclaw.json",
      "~/.openclaw/.env",
      "~/.openclaw/secrets.json",
      "~/.openclaw/credentials",
      "~/.openclaw/agents",
      "~/.openclaw/extensions",
